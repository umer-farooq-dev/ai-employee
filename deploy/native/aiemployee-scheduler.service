[Unit]
Description=AI Employee scheduled jobs (exactly one per environment)
After=network.target postgresql.service redis-server.service

[Service]
User=aiemployee
Group=aiemployee
WorkingDirectory=/opt/ai-employee/app/backend
Environment=DJANGO_SETTINGS_MODULE=config.settings.production PYTHONUNBUFFERED=1
ExecStart=/opt/ai-employee/venv/bin/python manage.py run_scheduler
Restart=always
RestartSec=5
Slice=aiemployee.slice
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
