[Unit]
Description=AI Employee website, panels, Super Admin, API and webhooks (gunicorn)
After=network.target postgresql.service redis-server.service

[Service]
User=aiemployee
Group=aiemployee
WorkingDirectory=/opt/ai-employee/app/backend
Environment=DJANGO_SETTINGS_MODULE=config.settings.production PYTHONUNBUFFERED=1
ExecStart=/opt/ai-employee/venv/bin/gunicorn config.wsgi --bind 127.0.0.1:8100 --worker-class gthread --workers 3 --threads 8 --timeout 60 --graceful-timeout 30 --access-logfile -
Restart=always
RestartSec=3
Slice=aiemployee.slice
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
