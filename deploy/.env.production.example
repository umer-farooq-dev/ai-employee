# Production / staging infrastructure values. Copy to deploy/.env on the server (never into git).
# Business values and every provider key are entered in Super Admin, not here.
# Random values: python -c "import secrets; print(secrets.token_urlsafe(64))"

ENVIRONMENT=production
DEBUG=False
DOMAIN=example.com
ACME_EMAIL=ops@example.com

SECRET_KEY=
FIELD_ENCRYPTION_KEY=
JWT_SIGNING_KEY=
ALLOWED_HOSTS=example.com,www.example.com,admin.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com,https://admin.example.com
ADMIN_HOST=admin.example.com
PUBLIC_BASE_URL=https://example.com
VOICE_GATEWAY_URL=wss://voice.example.com
VOICE_GATEWAY_BIND=0.0.0.0:8765

# Database: the containers below, or a managed PostgreSQL 16 with the "vector" extension
POSTGRES_DB=aiemployee
POSTGRES_USER=aiemployee
POSTGRES_PASSWORD=
APP_DB_USER=aiemployee_app
APP_DB_PASSWORD=
OWNER_DATABASE_URL=postgres://aiemployee:<POSTGRES_PASSWORD>@db:5432/aiemployee
DATABASE_URL=postgres://aiemployee_app:<APP_DB_PASSWORD>@db:5432/aiemployee

REDIS_PASSWORD=
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0

# Mail fallback only (the e-mail provider is chosen in Super Admin → Voice & Channels)
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=no-reply@example.com

# Upload malware scan (SEC-11): the clamav container; empty skips scanning
CLAMAV_ADDRESS=clamav:3310

# Optional
SENTRY_DSN=
LOG_LEVEL=INFO
BACKUP_KEEP_DAYS=14
