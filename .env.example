# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=local
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# docker compose services
DATABASE_URL=postgres://aiemployee:aiemployee@127.0.0.1:5432/aiemployee
REDIS_URL=redis://127.0.0.1:6379/0
EMAIL_URL=smtp://127.0.0.1:1025
DEFAULT_FROM_EMAIL=no-reply@localhost

# FreeLLMAPI (free LLM tiers, dev/staging only). Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FREELLMAPI_ENCRYPTION_KEY=

# Phase 0 PoC (poc/README.md). Client key created in the FreeLLMAPI dashboard.
LLM_API_KEY=
SARVAM_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
