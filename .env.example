# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=local
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,admin.localhost
# Super Admin on its own host (separate login from the website / company panel). Live: admin.<client domain>
ADMIN_HOST=admin.localhost:8000

# docker compose services
DATABASE_URL=postgres://aiemployee:aiemployee@127.0.0.1:5432/aiemployee
REDIS_URL=redis://127.0.0.1:6379/0
EMAIL_URL=smtp://127.0.0.1:1025
DEFAULT_FROM_EMAIL=no-reply@localhost

# FreeLLMAPI (free LLM tiers, dev/staging only). Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FREELLMAPI_ENCRYPTION_KEY=

# Virus scan for uploads (SEC-11): clamd address, e.g. 127.0.0.1:3310 (docker compose --profile scan up -d). Empty = skipped
CLAMAV_ADDRESS=
